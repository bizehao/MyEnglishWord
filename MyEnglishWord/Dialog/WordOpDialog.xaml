<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="MyEnglishWord.Dialog.WordOpDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Models="using:MyEnglishWord.Models"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MyEnglishWord.Dialog"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{x:Bind WordTitle}"
    Width="400"
    Height="400"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    PrimaryButtonText="确定"
    SecondaryButtonClick="ContentDialog_SecondaryButtonClick"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <Style BasedOn="{StaticResource DefaultContentDialogStyle}" TargetType="local:WordOpDialog" />
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            Width="400"
            Padding="10"
            Orientation="Vertical"
            Spacing="10">

            <!--  基础信息  -->
            <Expander
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Header="基础信息"
                IsExpanded="True">
                <StackPanel
                    Margin="0,8,0,0"
                    Orientation="Vertical"
                    Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Width="70" Text="单词:" />
                        <controls:SwitchPresenter TargetType="x:Boolean" Value="{x:Bind IsUpdate}">
                            <controls:Case Value="True">
                                <TextBlock Text="{x:Bind CurWord.Word, Mode=OneWay}" />
                            </controls:Case>
                            <controls:Case Value="False">
                                <TextBox Text="{x:Bind CurWord.Word, Mode=TwoWay}" />
                            </controls:Case>
                        </controls:SwitchPresenter>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Width="70" Text="音标:" />
                        <controls:SwitchPresenter TargetType="x:Boolean" Value="{x:Bind IsUpdate}">
                            <controls:Case Value="True">
                                <TextBlock Text="{x:Bind CurWord.Phonetic, Mode=OneWay}" />
                            </controls:Case>
                            <controls:Case Value="False">
                                <TextBox Text="{x:Bind CurWord.Phonetic, Mode=TwoWay}" />
                            </controls:Case>
                        </controls:SwitchPresenter>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!--  释义  -->
            <Expander
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Header="释义">

                <Grid Margin="0,8,0,0" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Width="70"
                        VerticalAlignment="Top"
                        Text="英文释义:" />
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Height="200"
                        HorizontalAlignment="Stretch"
                        AcceptsReturn="True"
                        PlaceholderText="每行一条释义"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        Text="{x:Bind CurWord.Definition, Mode=TwoWay}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Width="70"
                        VerticalAlignment="Top"
                        Text="中文释义:" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Height="200"
                        HorizontalAlignment="Stretch"
                        AcceptsReturn="True"
                        PlaceholderText="每行一条释义"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        Text="{x:Bind CurWord.Translation, Mode=TwoWay}" />
                </Grid>
            </Expander>

            <!--  词性、标签、星级  -->
            <Expander
                Grid.Row="2"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Header="词性与标签">
                <StackPanel Margin="0,8,0,0" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock
                            Width="70"
                            VerticalAlignment="Center"
                            Text="词性(Pos):" />
                        <TextBox
                            Width="200"
                            PlaceholderText="用 / 分隔"
                            Text="{x:Bind CurWord.Pos, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock
                            Width="70"
                            VerticalAlignment="Center"
                            Text="标签(Tag):" />
                        <TextBox
                            Width="200"
                            PlaceholderText="zk gk cet4 空格分隔"
                            Text="{x:Bind CurWord.Tag, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock
                            Width="70"
                            VerticalAlignment="Center"
                            Text="柯林斯星级:" />
                        <NumberBox
                            Width="200"
                            Maximum="5"
                            Minimum="0"
                            Value="{x:Bind CurWord.Collins, Mode=TwoWay}" />
                    </StackPanel>

                    <CheckBox Content="牛津三千核心词汇" IsChecked="{x:Bind CurWord.Oxford, Mode=OneWay}" />
                </StackPanel>
            </Expander>

            <!--  词频  -->
            <Expander
                Grid.Row="3"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Header="词频数据">
                <StackPanel Margin="0,8,0,0" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock
                            Width="70"
                            VerticalAlignment="Center"
                            Text="BNC词频:" />
                        <NumberBox
                            Width="200"
                            Minimum="0"
                            Value="{x:Bind CurWord.Bnc, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock
                            Width="70"
                            VerticalAlignment="Center"
                            Text="FRQ词频:" />
                        <NumberBox
                            Width="200"
                            Minimum="0"
                            Value="{x:Bind CurWord.Frq, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!--  变形、扩展信息  -->
            <Expander
                Grid.Row="4"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Header="变形与扩展">

                <Grid Margin="0,8,0,0" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Width="100"
                        VerticalAlignment="Top"
                        Text="变换:" />
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        PlaceholderText="用 / 分隔"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        Text="{x:Bind CurWord.Exchange, Mode=TwoWay}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Width="100"
                        VerticalAlignment="Top"
                        Text="Detail(JSON):" />

                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Height="200"
                        HorizontalAlignment="Stretch"
                        AcceptsReturn="True"
                        PlaceholderText="JSON扩展信息，例句等"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        Text="{x:Bind CurWord.Detail, Mode=TwoWay}" />
                </Grid>
            </Expander>

        </StackPanel>
    </ScrollViewer>

</ContentDialog>
