<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    x:Class="MyEnglishWord.Styles.MainPageStyle"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converter="using:MyEnglishWord.Helpers"
    xmlns:ctk="using:CommunityToolkit.WinUI.Converters"
    xmlns:custom="using:MyEnglishWord.Control"
    xmlns:helper="using:MyEnglishWord.Helpers"
    xmlns:layout="using:MyEnglishWord.Layout"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    xmlns:models="using:MyEnglishWord.Models"
    xmlns:ui="using:CommunityToolkit.WinUI">

    <Style
        x:Key="IndentedGridViewItemStyle"
        BasedOn="{StaticResource DefaultGridViewItemStyle}"
        TargetType="GridViewItem">
        <Setter Property="Margin" Value="12,0,0,12" />
    </Style>

    <ctk:BoolNegationConverter x:Key="BoolNegationConverter" />
    <ctk:StringVisibilityConverter x:Key="StringVisibilityConverter" />
    <helper:BoolToIconConverter x:Key="BoolToIconConverter" />
    <helper:PartOfSpeechToColorConverter x:Key="PartOfSpeechToColorConverter" />
    <helper:PartOfSpeechToTextConverter x:Key="PartOfSpeechToTextConverter" />


    <helper:ValueConverterGroup x:Key="WordArrayToStringConverter">
        <helper:JoinWordsConverter Seperator=", " />
        <helper:StringReplaceConverter NewValue=" " OldValue="_" />
    </helper:ValueConverterGroup>

    <DataTemplate x:Key="StaggeredTemplate" x:DataType="models:SynsetModel">
        <Frame
            Margin="5"
            Padding="5"
            BorderBrush="{x:Bind PSType, Converter={StaticResource PartOfSpeechToColorConverter}}"
            BorderThickness="2"
            CornerRadius="6">

            <ui:Effects.Shadow>
                <media:AttachedCardShadow CornerRadius="8" Offset="2,2" />
            </ui:Effects.Shadow>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    VerticalAlignment="Center"
                    FontSize="{ThemeResource TextStyleLargeFontSize}"
                    FontWeight="Bold"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind Words, Mode=OneWay, Converter={StaticResource WordArrayToStringConverter}}"
                    TextWrapping="Wrap">
                    <TextBlock.SelectionFlyout>
                        <custom:QueryableTextCommandBarFlyout />
                    </TextBlock.SelectionFlyout>
                    <TextBlock.ContextFlyout>
                        <custom:QueryableTextCommandBarFlyout />
                    </TextBlock.ContextFlyout>
                </TextBlock>
                <TextBlock
                    Grid.Row="1"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind Definition, Mode=OneWay}"
                    TextWrapping="Wrap">
                    <TextBlock.SelectionFlyout>
                        <custom:QueryableTextCommandBarFlyout />
                    </TextBlock.SelectionFlyout>
                    <TextBlock.ContextFlyout>
                        <custom:QueryableTextCommandBarFlyout />
                    </TextBlock.ContextFlyout>
                </TextBlock>
                <ListView
                    x:Name="ExampleListView"
                    Grid.Row="2"
                    Margin="0,5,0,5"
                    ItemsSource="{x:Bind Examples, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <RichTextBlock
                                    x:Name="ExampleRichTextBlock"
                                    Grid.Row="0"
                                    DataContextChanged="ExampleRichTextBlock_DataContextChanged"
                                    TextWrapping="Wrap">
                                    <RichTextBlock.SelectionFlyout>
                                        <custom:QueryableTextCommandBarFlyout />
                                    </RichTextBlock.SelectionFlyout>
                                    <RichTextBlock.ContextFlyout>
                                        <custom:QueryableTextCommandBarFlyout />
                                    </RichTextBlock.ContextFlyout>
                                </RichTextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <TextBlock
                    Grid.Row="3"
                    HorizontalAlignment="Right"
                    Text="{x:Bind PSType, Converter={StaticResource PartOfSpeechToTextConverter}}" />
            </Grid>
        </Frame>
    </DataTemplate>



    <DataTemplate x:Key="WordDetailTemplate" x:DataType="models:WordModel">
        <StackPanel
            Margin="10"
            Orientation="Vertical"
            Spacing="6">
            <!--  单词 + 音标  -->
            <StackPanel
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="12">
                <TextBlock
                    VerticalAlignment="Bottom"
                    FontSize="42"
                    FontWeight="SemiBold"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind Word, Mode=OneWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="20"
                    Foreground="#4488dd"
                    Text="{x:Bind Phonetic, Mode=OneWay}" />
                <Button
                    Padding="5"
                    VerticalAlignment="Center"
                    Command="{Binding ElementName=Root, Path=DataContext.HandlePlayWordCommand, Mode=OneWay}"
                    CommandParameter="{Binding}"
                    Visibility="{x:Bind Word, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}">
                    <FontIcon Glyph="&#xE994;" />
                </Button>
                <Button
                    x:Name="Speech"
                    Padding="5"
                    VerticalAlignment="Center"
                    Command="{Binding ElementName=Root, Path=DataContext.HandleReadWordCommand, Mode=OneWay}"
                    CommandParameter="{Binding}"
                    Visibility="{x:Bind Word, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}">
                    <FontIcon Glyph="{Binding ElementName=Root, Path=DataContext.IsSpeeching, Mode=OneWay, Converter={StaticResource BoolToIconConverter}, ConverterParameter='&#xE7C8;|&#xE720;'}" />
                </Button>


                <Button
                    x:Name="ToRecord"
                    Padding="5"
                    VerticalAlignment="Center"
                    Command="{Binding ElementName=Root, Path=DataContext.HandleAddDictCommand, Mode=OneWay}"
                    CommandParameter="{Binding}"
                    IsEnabled="{x:Bind InDictionary, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                    Visibility="{x:Bind Word, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}">
                    <FontIcon Glyph="{x:Bind InDictionary, Mode=OneWay, Converter={StaticResource BoolToIconConverter}, ConverterParameter='&#xE82D;|&#xE82E;'}" />
                </Button>

            </StackPanel>

            <!--  柯林斯星级｜牛津3000｜词频BNC/FRQ｜标签tag  -->
            <StackPanel
                Height="50"
                Orientation="Horizontal"
                Spacing="10">
                <Border
                    Padding="6,3"
                    Background="#f0e6b0"
                    CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            FontSize="14"
                            Text="柯林斯" />
                        <RatingControl
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            IsReadOnly="True"
                            PlaceholderValue="{x:Bind Collins, Mode=OneWay}"
                            Visibility="{x:Bind Word, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}" />
                    </Grid>
                </Border>

                <Border
                    Padding="6,3"
                    Background="Brown"
                    CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            FontSize="14"
                            Text="牛津三千" />
                        <!--  Cancel  -->
                        <SymbolIcon
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            Symbol="{x:Bind helper:OtherBindHelper.OxfordToSymbol(Oxford), Mode=OneWay}"
                            Visibility="{x:Bind Word, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}" />
                    </Grid>
                </Border>

                <Border
                    Padding="6,3"
                    Background="DodgerBlue"
                    CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            FontSize="14"
                            Text="标签" />
                        <TextBlock
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="{x:Bind Tag, Mode=OneWay}"
                            Visibility="{x:Bind Word, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}" />
                    </Grid>
                </Border>

                <Border
                    Padding="6,3"
                    Background="YellowGreen"
                    CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            FontSize="14"
                            Text="英国国家语料库词频顺序" />
                        <TextBlock
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="{x:Bind Bnc, Mode=OneWay}"
                            Visibility="{x:Bind Word, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}" />
                    </Grid>
                </Border>

                <Border
                    Padding="6,3"
                    Background="YellowGreen"
                    CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            FontSize="14"
                            Text="当代语料库词频顺序" />
                        <TextBlock
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="{x:Bind Frq, Mode=OneWay}"
                            Visibility="{x:Bind Word, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}" />
                    </Grid>
                </Border>
            </StackPanel>

            <!--  词性 pos  -->
            <TextBlock
                FontSize="16"
                Foreground="#cc5522"
                Text="{x:Bind Pos}" />

            <!--  变形 exchange  -->
            <StackPanel>
                <TextBlock
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="变换形式：" />
                <TextBlock
                    FontSize="14"
                    Text="{x:Bind Exchange, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!--  英文释义 definition（多行）  -->
            <StackPanel
                Padding="10"
                Background="Cornsilk"
                CornerRadius="8">
                <TextBlock
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="英文释义：" />
                <TextBlock
                    FontSize="14"
                    LineHeight="24"
                    Text="{x:Bind Definition, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!--  中文释义 translation（多行）  -->
            <StackPanel
                Padding="10"
                Background="Cornsilk"
                CornerRadius="8">
                <TextBlock
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="中文释义：" />
                <TextBlock
                    FontSize="14"
                    LineHeight="24"
                    Text="{x:Bind Translation, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!--  detail  -->
            <StackPanel
                Padding="10"
                Background="Cornsilk"
                CornerRadius="8">
                <TextBlock
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="扩展信息：" />
                <TextBlock
                    FontSize="14"
                    LineHeight="24"
                    Text="{x:Bind Detail, Mode=OneWay}"
                    TextWrapping="Wrap" />

            </StackPanel>

            <ItemsRepeater
                x:Name="StaggeredRepeater"
                ItemTemplate="{StaticResource StaggeredTemplate}"
                ItemsSource="{x:Bind Synsets, Mode=OneWay}">
                <ItemsRepeater.Layout>

                    <layout:StaggeredLayout
                        ColumnSpacing="5"
                        DesiredColumnWidth="250"
                        ItemsStretch="Fill"
                        RowSpacing="5" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>


            <!--<GridView ItemTemplate="{StaticResource StaggeredTemplate}" ItemsSource="{x:Bind Synsets, Mode=OneWay}">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:StaggeredPanel
                            ColumnSpacing="5"
                            DesiredColumnWidth="250"
                            RowSpacing="5" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
            </GridView>-->


        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ControlItemTemplate" x:DataType="models:WordModel">
        <Grid
            x:Name="controlRoot"
            Width="240"
            Height="160"
            Padding="10"
            HorizontalAlignment="Stretch"
            Background="{ThemeResource ControlFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            ColumnSpacing="16"
            CornerRadius="{StaticResource OverlayCornerRadius}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                Orientation="Horizontal"
                Spacing="10">
                <TextBlock
                    x:Name="titleText"
                    VerticalAlignment="Bottom"
                    FontSize="25"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind Word, Mode=OneWay}"
                    TextLineBounds="TrimToCapHeight"
                    TextWrapping="NoWrap" />

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="#4488dd"
                    Text="{x:Bind Phonetic, Mode=OneWay}" />
            </StackPanel>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock FontSize="14" Text="牛津三千:" />
                    <TextBlock
                        Grid.Row="1"
                        FontSize="14"
                        Text="{x:Bind helper:OtherBindHelper.OxfordToText(Oxford), Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <TextBlock
                        Grid.Row="0"
                        FontSize="14"
                        Text="标签:" />
                    <TextBlock
                        Grid.Row="1"
                        FontSize="14"
                        Text="{x:Bind Tag, Mode=OneWay}" />
                </StackPanel>
                <TextBlock Grid.Row="2" FontSize="14">
                    <Run Text="英语国家词频顺序:" />
                    <Run Text="{x:Bind Bnc, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Grid.Row="3" FontSize="14">
                    <Run Text="当代语料库词频顺序:" />
                    <Run Text="{x:Bind Frq, Mode=OneWay}" />
                </TextBlock>
            </Grid>

            <Border
                Grid.Row="2"
                Margin="-10,0,-10,-10"
                VerticalAlignment="Bottom"
                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                CornerRadius="0,0,7,7">
                <RatingControl
                    VerticalAlignment="Center"
                    IsReadOnly="True"
                    PlaceholderValue="{x:Bind Collins, Mode=OneWay}" />
            </Border>
            <!--<VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="LayoutVisualStates">
                    <VisualState x:Name="WideLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="{StaticResource Breakpoint640Plus}" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters />
                    </VisualState>
                    <VisualState x:Name="NarrowLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="controlRoot.Width" Value="Auto" />
                            <Setter Target="controlRoot.Height" Value="120" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>-->

            <Button
                Grid.Row="0"
                Width="32"
                Height="32"
                Padding="0"
                HorizontalAlignment="Right"
                Command="{Binding ElementName=ItemGridView, Path=DataContext.HandleShowDetailCommand, Mode=OneWay}"
                CommandParameter="{Binding}">
                <SymbolIcon Symbol="Go" />
            </Button>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
