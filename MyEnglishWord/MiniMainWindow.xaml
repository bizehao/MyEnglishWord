<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MyEnglishWord.MiniMainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MyEnglishWord"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MiniMainWindow"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="English">
            <TitleBar.Resources>
                <x:String x:Key="TitleBarContentHorizontalAlignment">Stretch</x:String>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <FontIconSource Glyph="&#xE700;" />
            </TitleBar.IconSource>
            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                <ToggleSwitch
                    MinWidth="80"
                    MaxWidth="80"
                    IsOn="True"
                    OffContent="取消置顶"
                    OnContent="置顶"
                    Toggled="ToggleSwitch_Toggled" />
            </StackPanel>
        </TitleBar>

        <Frame x:Name="ContentFrame" Grid.Row="1" />
    </Grid>
</Window>
