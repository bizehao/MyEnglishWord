<Page
    x:Class="MyEnglishWord.Views.MyWordRecordPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:MyEnglishWord.Behaviors"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:Microsoft.UI.Xaml.Controls"
    xmlns:helper="using:MyEnglishWord.Helpers"
    xmlns:local="using:MyEnglishWord.Core.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    behaviors:NavigationViewHeaderBehavior.HeaderMode="Never"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Name="ImageOverlayTemplate" x:DataType="local:MyWordRecord">
            <Grid Height="66" MinWidth="160">
                <Border
                    Background="#CACBC6"
                    BorderBrush="CadetBlue"
                    BorderThickness="2"
                    CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Grid.Row="0"
                            Padding="10,0"
                            Orientation="Horizontal"
                            Spacing="10">
                            <TextBlock
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="20"
                                Foreground="#280FF6"
                                HorizontalTextAlignment="Center"
                                Text="{x:Bind Word}" />
                            <Button
                                Padding="4"
                                VerticalAlignment="Center"
                                Command="{Binding ElementName=ContentArea, Path=DataContext.HandlePlayWordCommand, Mode=OneWay}"
                                CommandParameter="{x:Bind Word}">
                                <FontIcon Glyph="&#xE994;" />
                            </Button>
                            <Button
                                x:Name="Translate"
                                Padding="4"
                                VerticalAlignment="Center"
                                Command="{Binding ElementName=ContentArea, Path=DataContext.HandleWordTranslateCommand, Mode=OneWay}"
                                CommandParameter="{x:Bind}">
                                <FontIcon Glyph="&#xF1D4;" />
                                <Button.Flyout>
                                    <Flyout>
                                        <StackPanel>
                                            <TextBlock
                                                Margin="4"
                                                helper:AncestorSource.AncestorType="ScrollViewer"
                                                Text="{Binding WordTranslate, Mode=OneWay}"
                                                TextWrapping="WrapWholeWords" />
                                            <!--
                                                ItemsRepeater bug
                                                <TextBlock
                                                    Margin="4"
                                                    Text="{Binding ElementName=ContentArea, Path=DataContext.WordTranslate, Mode=OneWay}"
                                                    TextWrapping="WrapWholeWords" />
                                            -->
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                        </StackPanel>

                        <Border
                            Grid.Row="1"
                            Background="#131212"
                            CornerRadius="0,0,4,4"
                            Opacity=".75">
                            <TextBlock
                                FontSize="12"
                                Foreground="#DAE7D0"
                                HorizontalTextAlignment="Center"
                                Text="{x:Bind Time}" />
                        </Border>
                    </Grid>
                </Border>

                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            Click="MenuFlyoutItem_Click"
                            DataContext="{x:Bind}"
                            Tag="detail"
                            Text="查看详情" />
                        <MenuFlyoutItem
                            Click="MenuFlyoutItem_Click"
                            DataContext="{x:Bind}"
                            Tag="delete"
                            Text="删除" />
                    </MenuFlyout>
                </Grid.ContextFlyout>
            </Grid>
        </DataTemplate>

        <Color x:Key="WordTotalCountTextColor">#F4CC10</Color>
    </Page.Resources>

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="30">
            <AutoSuggestBox
                x:Name="SearchMyWord"
                Grid.Row="0"
                Width="200"
                HorizontalAlignment="Left"
                PlaceholderText="input word"
                QueryIcon="Find"
                QuerySubmitted="SearchMyWord_QuerySubmitted"
                TextChanged="SearchMyWord_TextChanged" />

            <Border
                Padding="10,0"
                Background="#424441"
                CornerRadius="6">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Foreground="{StaticResource WordTotalCountTextColor}" Text="已记忆单词" />
                    <TextBlock Foreground="{StaticResource WordTotalCountTextColor}" Text="{x:Bind ViewModel.WordTotalCount, Mode=OneWay}" />
                    <TextBlock Foreground="{StaticResource WordTotalCountTextColor}" Text="个" />
                </StackPanel>
            </Border>

        </StackPanel>

        <ScrollViewer x:Name="ContentArea" Grid.Row="1">
            <ItemsRepeater ItemTemplate="{StaticResource ImageOverlayTemplate}" ItemsSource="{x:Bind ViewModel.WordRecords, Mode=OneWay}">

                <ItemsRepeater.Layout>
                    <controls:WrapLayout
                        HorizontalSpacing="10"
                        Orientation="Horizontal"
                        VerticalSpacing="10" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>

        <ext:PagerControl
            x:Name="Pager"
            Grid.Row="2"
            DisplayMode="ButtonPanel"
            FirstButtonVisibility="Visible"
            LastButtonVisibility="Visible"
            NextButtonVisibility="Visible"
            NumberOfPages="{x:Bind ViewModel.PageCount, Mode=OneWay}"
            PreviousButtonVisibility="Visible"
            SelectedIndexChanged="Pager_SelectedIndexChanged"
            SelectedPageIndex="{x:Bind ViewModel.CurrentPage, Mode=TwoWay}" />

    </Grid>

</Page>
