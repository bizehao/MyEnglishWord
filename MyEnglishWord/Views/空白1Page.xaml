<Page
    x:Class="MyEnglishWord.Views.空白1Page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tv="using:WinUI.TableView"
    mc:Ignorable="d">

    <Grid x:Name="ContentArea">
        <Grid.Resources>
            <ResourceDictionary>
                <Style x:Name="CenterTextStyle" TargetType="tv:TableViewColumnHeader">
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                </Style>
                <SolidColorBrush x:Key="TableViewRowBackgroundSelected" Color="#C0BDBB" />
                <SolidColorBrush x:Key="TableViewRowBackgroundSelectedPointerOver" Color="#B0C0BDBB" />
                <SolidColorBrush x:Key="TableViewRowBackgroundPointerOver" Color="#D8E3C3" />
            </ResourceDictionary>
        </Grid.Resources>
        <tv:TableView
            x:Name="tableView"
            AutoGenerateColumns="False"
            CellContextFlyoutOpening="OnCellContextFlyoutOpening"
            ColumnHeaderStyle="{StaticResource CenterTextStyle}"
            ForceRowOrCellSelectionOnContextRequested="True"
            GridLinesVisibility="All"
            IsReadOnly="True"
            SelectionMode="Single"
            SelectionUnit="Row"
            ShowDragRectangle="False"
            VerticalGridLinesStrokeThickness="3">

            <!--<tv:TableView.CellContextFlyout>
        <MenuFlyout>
            <MenuFlyoutItem
        x:Name="open"
        Click="OpenWithMirroredHandler"
        Text="打开路径">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xEA5C;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </tv:TableView.CellContextFlyout>-->

            <tv:TableView.Columns>
                <tv:TableViewTextColumn
                    Width="*"
                    Binding="{Binding Word}"
                    CanFilter="False"
                    CanSort="False"
                    Header="单词名称" />
                <tv:TableViewTextColumn
                    Width="2*"
                    Binding="{Binding Phonetic}"
                    Header="音标" />
                <tv:TableViewTextColumn
                    Width="*"
                    Binding="{Binding Definition}"
                    Header="单词释义(英文)" />
                <tv:TableViewTextColumn
                    Width="3*"
                    Binding="{Binding Translation}"
                    Header="单词释义(中文)" />
                <tv:TableViewTextColumn
                    Width="3*"
                    Binding="{Binding Collins}"
                    Header="柯林斯星级" />
                <tv:TableViewTextColumn
                    Width="3*"
                    Binding="{Binding Oxford}"
                    Header="牛津三千核心词汇" />
                <tv:TableViewTextColumn
                    Width="3*"
                    Binding="{Binding Tag}"
                    Header="标签" />
            </tv:TableView.Columns>
        </tv:TableView>
    </Grid>
</Page>
