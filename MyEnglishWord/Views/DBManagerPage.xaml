<Page
    x:Class="MyEnglishWord.Views.DBManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:MyEnglishWord.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tv="using:WinUI.TableView"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Grid x:Name="ContentArea" RowSpacing="10">
        <Grid.Resources>
            <ResourceDictionary>
                <Style x:Name="CenterTextStyle" TargetType="tv:TableViewColumnHeader">
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                </Style>
                <SolidColorBrush x:Key="TableViewRowBackgroundSelected" Color="#C0BDBB" />
                <SolidColorBrush x:Key="TableViewRowBackgroundSelectedPointerOver" Color="#B0C0BDBB" />
                <SolidColorBrush x:Key="TableViewRowBackgroundPointerOver" Color="#D8E3C3" />
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            Spacing="10">
            <AutoSuggestBox
                x:Name="SearchMyWord"
                Width="200"
                HorizontalAlignment="Left"
                PlaceholderText="input word"
                QueryIcon="Find"
                QuerySubmitted="SearchMyWord_QuerySubmitted"
                TextChanged="SearchMyWord_TextChanged" />
            <Button Padding="5" Click="AddWord_Click">
                <FontIcon Glyph="&#xE710;" />
            </Button>
        </StackPanel>
        <tv:TableView
            x:Name="tableView"
            Grid.Row="1"
            AutoGenerateColumns="False"
            CellContextFlyoutOpening="OnCellContextFlyoutOpening"
            ColumnHeaderStyle="{StaticResource CenterTextStyle}"
            ForceRowOrCellSelectionOnContextRequested="True"
            GridLinesVisibility="All"
            IsReadOnly="True"
            ItemsSource="{x:Bind ViewModel.Words, Mode=OneWay}"
            SelectionMode="Single"
            SelectionUnit="Row"
            ShowDragRectangle="False"
            VerticalGridLinesStrokeThickness="3">

            <tv:TableView.CellContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem
                        x:Name="ToSee"
                        Click="ToSee_Click"
                        Text="查看">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xED37;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        x:Name="ToUpdate"
                        Click="ToUpdate_Click"
                        Text="修改">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE70F;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </tv:TableView.CellContextFlyout>

            <tv:TableView.Columns>
                <tv:TableViewTextColumn
                    Width="*"
                    Binding="{Binding Word}"
                    CanFilter="False"
                    CanSort="False"
                    Header="单词名称" />
                <tv:TableViewTextColumn
                    Width="*"
                    Binding="{Binding Phonetic}"
                    Header="音标" />
                <tv:TableViewTextColumn
                    Width="*"
                    Binding="{Binding Frq}"
                    Header="当代语料词频顺序" />
                <tv:TableViewTextColumn
                    Width="*"
                    Binding="{Binding Bnc}"
                    Header="英国国家词频顺序" />
                <tv:TableViewTextColumn
                    Width="*"
                    Binding="{Binding Collins}"
                    Header="柯林斯星级" />
                <tv:TableViewTextColumn
                    Width="*"
                    Binding="{Binding Oxford}"
                    Header="牛津三千核心词汇" />
                <tv:TableViewTextColumn
                    Width="*"
                    Binding="{Binding Tag}"
                    Header="标签" />
            </tv:TableView.Columns>
        </tv:TableView>

        <ext:PagerControl
            x:Name="Pager"
            Grid.Row="2"
            DisplayMode="ButtonPanel"
            FirstButtonVisibility="Visible"
            LastButtonVisibility="Visible"
            NextButtonVisibility="Visible"
            NumberOfPages="{x:Bind ViewModel.PageCount, Mode=OneWay}"
            PreviousButtonVisibility="Visible"
            SelectedIndexChanged="Pager_SelectedIndexChanged"
            SelectedPageIndex="{x:Bind ViewModel.CurrentPage, Mode=TwoWay}" />
    </Grid>
</Page>
