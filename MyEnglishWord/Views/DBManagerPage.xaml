<Page
    x:Class="MyEnglishWord.Views.DBManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:MyEnglishWord.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:Microsoft.UI.Xaml.Controls"
    xmlns:helper="using:MyEnglishWord.Helpers"
    xmlns:local="using:MyEnglishWord.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tv="using:WinUI.TableView"
    behaviors:NavigationViewHeaderBehavior.HeaderMode="Never"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Name="CenterTextStyle" TargetType="tv:TableViewColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <SolidColorBrush x:Key="TableViewRowBackgroundSelected" Color="#C0BDBB" />
        <SolidColorBrush x:Key="TableViewRowBackgroundSelectedPointerOver" Color="#B0C0BDBB" />
        <SolidColorBrush x:Key="TableViewRowBackgroundPointerOver" Color="#D8E3C3" />
        <helper:BoolToIconConverter x:Key="BoolToIconConverter" />
    </Page.Resources>

    <Grid x:Name="ContentArea" RowSpacing="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            Spacing="10">
            <AutoSuggestBox
                x:Name="SearchMyWord"
                Width="200"
                HorizontalAlignment="Left"
                PlaceholderText="input word"
                QueryIcon="Find"
                QuerySubmitted="SearchMyWord_QuerySubmitted"
                TextChanged="SearchMyWord_TextChanged" />
            <Button Padding="5" Click="AddWord_Click">
                <FontIcon Glyph="&#xE710;" />
            </Button>
            <Button Padding="5" Click="MiniWindow_Click">
                <FontIcon Glyph="&#xE802;" />
            </Button>
        </StackPanel>

        <Grid Grid.Row="1">

            <Grid.Resources>
                <Style x:Key="RowTextStyle" TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                </Style>
                <Style
                    x:Key="TitleTextStyle"
                    BasedOn="{StaticResource RowTextStyle}"
                    TargetType="TextBlock">
                    <Setter Property="FontWeight" Value="Bold" />
                </Style>
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                Grid.Row="0"
                Padding="16,0,12,0"
                BorderBrush="Black"
                BorderThickness="1,1,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource TitleTextStyle}"
                    Text="单词名称" />
                <!--  分割线  -->
                <Rectangle
                    Grid.Row="0"
                    Grid.Column="1"
                    Fill="LightGray" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="2"
                    Style="{StaticResource TitleTextStyle}"
                    Text="音标" />
                <!--  分割线  -->
                <Rectangle
                    Grid.Row="0"
                    Grid.Column="3"
                    Fill="LightGray" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="4"
                    Style="{StaticResource TitleTextStyle}"
                    Text="当代语料词频顺序" />
                <!--  分割线  -->
                <Rectangle
                    Grid.Row="0"
                    Grid.Column="5"
                    Fill="LightGray" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="6"
                    Style="{StaticResource TitleTextStyle}"
                    Text="英国国家词频顺序" />
                <!--  分割线  -->
                <Rectangle
                    Grid.Row="0"
                    Grid.Column="7"
                    Fill="LightGray" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="8"
                    Style="{StaticResource TitleTextStyle}"
                    Text="柯林斯星级" />
                <!--  分割线  -->
                <Rectangle
                    Grid.Row="0"
                    Grid.Column="9"
                    Fill="LightGray" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="10"
                    Style="{StaticResource TitleTextStyle}"
                    Text="牛津三千核心词汇" />
                <!--  分割线  -->
                <Rectangle
                    Grid.Row="0"
                    Grid.Column="11"
                    Fill="LightGray" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="12"
                    Style="{StaticResource TitleTextStyle}"
                    Text="标签" />
                <!--  分割线  -->
                <Rectangle
                    Grid.Row="0"
                    Grid.Column="13"
                    Fill="LightGray" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="14"
                    Style="{StaticResource TitleTextStyle}"
                    Text="记忆" />
            </Grid>

            <ListView
                x:Name="listView"
                Grid.Row="1"
                BorderBrush="Black"
                BorderThickness="1"
                ItemsSource="{x:Bind ViewModel.Words, Mode=OneWay}"
                SelectionChanged="listView_SelectionChanged">

                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:WordModel">
                        <Grid Background="Transparent">
                            <Grid.ContextFlyout>
                                <MenuFlyout Opening="MenuFlyout_Opening">
                                    <MenuFlyoutItem
                                        x:Name="ToSee"
                                        Click="ToSee_Click"
                                        Text="查看">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xED37;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        x:Name="ToUpdate"
                                        Click="ToUpdate_Click"
                                        Text="修改">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE70F;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        x:Name="ToRecord"
                                        Click="ToRecord_Click"
                                        Text="添加记录">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE718;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="1" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Style="{StaticResource RowTextStyle}"
                                Text="{x:Bind Word, Mode=OneWay}" />
                            <!--  分割线  -->
                            <Rectangle
                                Grid.Row="0"
                                Grid.Column="1"
                                Fill="LightGray" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="2"
                                Style="{StaticResource RowTextStyle}"
                                Text="{x:Bind Phonetic, Mode=OneWay}" />
                            <!--  分割线  -->
                            <Rectangle
                                Grid.Row="0"
                                Grid.Column="3"
                                Fill="LightGray" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="4"
                                Style="{StaticResource RowTextStyle}"
                                Text="{x:Bind Frq, Mode=OneWay}" />
                            <!--  分割线  -->
                            <Rectangle
                                Grid.Row="0"
                                Grid.Column="5"
                                Fill="LightGray" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="6"
                                Style="{StaticResource RowTextStyle}"
                                Text="{x:Bind Bnc, Mode=OneWay}" />
                            <!--  分割线  -->
                            <Rectangle
                                Grid.Row="0"
                                Grid.Column="7"
                                Fill="LightGray" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="8"
                                Style="{StaticResource RowTextStyle}"
                                Text="{x:Bind Collins, Mode=OneWay}" />
                            <!--  分割线  -->
                            <Rectangle
                                Grid.Row="0"
                                Grid.Column="9"
                                Fill="LightGray" />
                            <FontIcon
                                Grid.Row="0"
                                Grid.Column="10"
                                Glyph="{x:Bind Oxford, Mode=OneWay, Converter={StaticResource BoolToIconConverter}, ConverterParameter='&#xE8FB;|&#xE711;'}" />
                            <!--  分割线  -->
                            <Rectangle
                                Grid.Row="0"
                                Grid.Column="11"
                                Fill="LightGray" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="12"
                                Style="{StaticResource RowTextStyle}"
                                Text="{x:Bind Tag, Mode=OneWay}" />
                            <!--  分割线  -->
                            <Rectangle
                                Grid.Row="0"
                                Grid.Column="13"
                                Fill="LightGray" />
                            <!--<FontIcon
                                Grid.Row="0"
                                Grid.Column="14"
                                Glyph="{x:Bind InDictionary, Mode=OneWay, Converter={StaticResource BoolToIconConverter}, ConverterParameter='&#xE73D;|&#xE739;'}" />-->
                            <Grid Grid.Row="0" Grid.Column="14">
                                <ToggleSwitch
                                    MinWidth="100"
                                    MinHeight="30"
                                    MaxWidth="100"
                                    MaxHeight="30"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    IsOn="{x:Bind InDictionary, Mode=OneWay}"
                                    OffContent="未添加"
                                    OnContent="已添加" />
                                <Button
                                    MinWidth="100"
                                    MinHeight="30"
                                    MaxWidth="100"
                                    MaxHeight="30"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    Click="ToggleSwitch_Click" />
                            </Grid>

                            <!--  分割线  -->
                            <Rectangle
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="16"
                                HorizontalAlignment="Stretch"
                                Fill="LightGray" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <ext:PagerControl
            x:Name="Pager"
            Grid.Row="2"
            DisplayMode="ButtonPanel"
            FirstButtonVisibility="Visible"
            LastButtonVisibility="Visible"
            NextButtonVisibility="Visible"
            NumberOfPages="{x:Bind ViewModel.PageCount, Mode=OneWay}"
            PreviousButtonVisibility="Visible"
            SelectedIndexChanged="Pager_SelectedIndexChanged"
            SelectedPageIndex="{x:Bind ViewModel.CurrentPage, Mode=TwoWay}" />
    </Grid>
</Page>
