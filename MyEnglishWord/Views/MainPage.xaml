<Page
    x:Class="MyEnglishWord.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:MyEnglishWord.Behaviors"
    xmlns:ctk="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helper="using:MyEnglishWord.Helpers"
    xmlns:localStyle="using:MyEnglishWord.Styles"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    behaviors:NavigationViewHeaderBehavior.HeaderMode="Never"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <ctk:CollectionVisibilityConverter x:Key="CollectionVisibilityConverter" />
                </ResourceDictionary>
                <localStyle:MainPageStyle />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="ContentArea">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel
            Grid.Row="0"
            Margin="0,10"
            Orientation="Vertical"
            Spacing="5">
            <StackPanel Orientation="Horizontal">
                <AutoSuggestBox
                    x:Name="SearchBox"
                    Width="200"
                    HorizontalAlignment="Left"
                    PlaceholderText="请输入搜索单词"
                    QueryIcon="Find"
                    QuerySubmitted="AutoSuggestBox_QuerySubmitted" />
                <TextBlock x:Name="TestData" />
            </StackPanel>

            <ProgressBar
                x:Name="Progress"
                Width="200"
                HorizontalAlignment="Left"
                IsIndeterminate="True"
                ShowError="False"
                ShowPaused="false"
                Visibility="Collapsed" />
        </StackPanel>
        <ScrollView Grid.Row="1">
            <StackPanel Orientation="Vertical" Spacing="20">

                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderThickness="2"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Loaded="ShadowRect_Loaded"
                    Translation="0,0,25">
                    <Border.Shadow>
                        <ThemeShadow x:Name="shadow" />
                    </Border.Shadow>

                    <ContentPresenter Content="{x:Bind ViewModel.CurrentWord, Mode=OneWay}" ContentTemplate="{StaticResource WordDetailTemplate}" />

                </Border>
                <Border>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="推荐" Visibility="{x:Bind ViewModel.Items, Mode=OneWay, Converter={StaticResource CollectionVisibilityConverter}}" />
                        <GridView
                            x:Name="ItemGridView"
                            Padding="24,16,24,36"
                            IsItemClickEnabled="True"
                            IsSwipeEnabled="False"
                            ItemClick="OnItemGridViewItemClick"
                            ItemContainerStyle="{StaticResource IndentedGridViewItemStyle}"
                            ItemTemplate="{StaticResource ControlItemTemplate}"
                            ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                            SelectionMode="None">
                            <GridView.Resources>
                                <CornerRadius x:Key="GridViewItemCornerRadius">8</CornerRadius>
                            </GridView.Resources>
                        </GridView>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollView>

        <Grid Grid.Row="0" Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="7*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="StandardPopupPos"
                Grid.Row="1"
                Grid.Column="1" />

            <Popup
                x:Name="StandardPopup"
                Grid.Row="1"
                Grid.Column="1"
                IsLightDismissEnabled="True">
                <Popup.ChildTransitions>
                    <TransitionCollection>
                        <PaneThemeTransition Edge="Top" />
                    </TransitionCollection>
                </Popup.ChildTransitions>

                <Grid
                    x:Name="StandardPopupGrid"
                    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource OverlayCornerRadius}">
                    <Grid.Shadow>
                        <ThemeShadow />
                    </Grid.Shadow>
                    <ScrollView x:Name="StandardPopupScrollView">
                        <ContentPresenter
                            x:Name="StandardPopupContent"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Content="{x:Bind ViewModel.LikeWordDetail, Mode=OneWay}"
                            ContentTemplate="{StaticResource WordDetailTemplate}" />
                    </ScrollView>
                    <Button
                        Padding="5"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Click="ClosePopupButton_Click">
                        <FontIcon Glyph="&#xE711;" />
                    </Button>
                </Grid>
            </Popup>
        </Grid>

        <InfoBar
            x:Name="SpeekInfoBar"
            Title="提示"
            Grid.Row="0"
            Grid.RowSpan="2"
            Width="300"
            HorizontalAlignment="Right"
            IsClosable="True"
            IsIconVisible="True"
            IsOpen="{x:Bind ViewModel.SpeekInfoBarOpen, Mode=OneWay}"
            Message="{x:Bind ViewModel.SpeekInfoBarMsg, Mode=OneWay}"
            Severity="{x:Bind ViewModel.SpeekInfoBarSeverity, Mode=OneWay}" />
    </Grid>
</Page>
