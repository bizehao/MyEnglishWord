<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MyEnglishWord.Views.MiniMainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctk="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helper="using:MyEnglishWord.Helpers"
    xmlns:local="using:MyEnglishWord.Views"
    xmlns:localStyle="using:MyEnglishWord.Styles"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <localStyle:MainPageStyle />
    </Page.Resources>

    <Grid x:Name="ContentArea">

        <ScrollView>
            <ContentPresenter Content="{x:Bind ViewModel.CurrentWord, Mode=OneWay}" ContentTemplate="{StaticResource WordDetailTemplate}" />
        </ScrollView>

        <InfoBar
            x:Name="SpeekInfoBar"
            Title="提示"
            Grid.Row="0"
            Grid.RowSpan="2"
            Width="300"
            HorizontalAlignment="Right"
            IsClosable="True"
            IsIconVisible="True"
            IsOpen="{x:Bind ViewModel.SpeekInfoBarOpen, Mode=OneWay}"
            Message="{x:Bind ViewModel.SpeekInfoBarMsg, Mode=OneWay}"
            Severity="{x:Bind ViewModel.SpeekInfoBarSeverity, Mode=OneWay}" />
    </Grid>
</Page>
