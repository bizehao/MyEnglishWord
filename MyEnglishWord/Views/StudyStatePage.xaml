<Page
    x:Class="MyEnglishWord.Views.StudyStatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:MyEnglishWord.Behaviors"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MyEnglishWord.Models"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="ThisPage"
    behaviors:NavigationViewHeaderBehavior.HeaderMode="Never"
    NavigationCacheMode="Disabled"
    mc:Ignorable="d">

    <Page.Resources>

        <DataTemplate x:Key="ExpressPictStateTemplate" x:DataType="local:ExpressPictState">
            <StackPanel
                Background="Transparent"
                ContextRequested="StackPanel_ContextRequested"
                Orientation="Horizontal"
                Spacing="10">
                <TextBlock
                    Width="40"
                    VerticalAlignment="Center"
                    Text="{x:Bind}" />
                <controls:ColorPickerButton HorizontalAlignment="Center" SelectedColor="{x:Bind Color, Mode=TwoWay}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="ContentArea" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <SelectorBar
            x:Name="SelectorBar"
            Grid.Row="0"
            SelectionChanged="SelectorBar_SelectionChanged">

            <SelectorBarItem
                x:Name="SelectorBarItemPage4"
                IsSelected="True"
                Text="活动图" />
            <SelectorBarItem x:Name="SelectorBarItemPage3" Text="学习图" />

        </SelectorBar>

        <controls:SwitchPresenter
            Grid.Row="1"
            Margin="0,10"
            Value="{Binding SelectedItem.Text, ElementName=SelectorBar}">
            <!--  And then only dynamically displays the Case with the matching Value  -->
            <controls:Case IsDefault="True" Value="活动图">
                <Grid Loaded="Active_loaded" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="10">
                            <DatePicker
                                x:Name="Active_StartDatePicker"
                                Header="开始日期"
                                Language="zh-CN" />
                            <DatePicker
                                x:Name="Active_EndDatePicker"
                                Header="结束日期"
                                Language="zh-CN" />
                            <ComboBox
                                x:Name="Active_ChooseWay"
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                SelectedIndex="{x:Bind ViewModel.Active_ShowWayIndex, Mode=TwoWay}">
                                <x:String>日</x:String>
                                <x:String>月</x:String>
                                <x:String>年</x:String>
                            </ComboBox>
                            <Button
                                VerticalAlignment="Bottom"
                                Click="Active_ChartButton_Click"
                                Content="查询" />
                        </StackPanel>

                        <RadioButtons
                            x:Name="RadioButtons_ActiveChartType"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Header="活动图:"
                            MaxColumns="2"
                            SelectedIndex="0">
                            <RadioButton Checked="RadioButton_WordPerDay_Checked" Content="每日单词图" />
                            <RadioButton Checked="RadioButton_WordTotal_Checked" Content="单词总量图" />
                        </RadioButtons>
                    </Grid>


                    <TextBlock
                        x:Name="Active_ChartTitle"
                        Grid.Row="1"
                        Margin="0,10,0,10"
                        FontSize="20"
                        FontWeight="Bold"
                        Text="活动图:" />
                    <lvc:CartesianChart
                        x:Name="Active_MyChart"
                        Grid.Row="2"
                        LegendPosition="Right"
                        Series="{x:Bind ViewModel.Active_Series, Mode=OneWay}"
                        Visibility="Collapsed"
                        XAxes="{x:Bind ViewModel.Active_XAxes, Mode=OneWay}"
                        YAxes="{x:Bind ViewModel.Active_YAxes, Mode=OneWay}" />
                </Grid>
            </controls:Case>
            <controls:Case Value="学习图">
                <Grid Loaded="Increase_loaded" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        Orientation="Horizontal"
                        Spacing="10">
                        <DatePicker
                            x:Name="Increase_StartDatePicker"
                            Header="开始日期"
                            Language="zh-CN" />
                        <DatePicker
                            x:Name="Increase_EndDatePicker"
                            Header="结束日期"
                            Language="zh-CN" />
                        <Button
                            VerticalAlignment="Bottom"
                            Click="Increase_ChartButton_Click"
                            Content="查询" />
                    </StackPanel>

                    <TextBlock
                        x:Name="Increase_ChartTitle"
                        Grid.Row="1"
                        Margin="0,10,0,10"
                        FontSize="20"
                        FontWeight="Bold"
                        Text="学习图:" />
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <lvc:PieChart
                            x:Name="PieChart"
                            Series="{x:Bind ViewModel.PieChartSeries, Mode=OneWay}"
                            Visibility="Collapsed">
                            <lvc:PieChart.Title>
                                <lvc:XamlDrawnLabelVisual
                                    Padding="{lvc:Padding Value='15'}"
                                    Paint="{lvc:SolidColorPaint Color='#000'}"
                                    Text="我的记忆比例"
                                    TextSize="{lvc:Float Value='25'}" />
                            </lvc:PieChart.Title>
                        </lvc:PieChart>

                        <Border
                            x:Name="ShadowRect"
                            Grid.Column="1"
                            Width="150"
                            Height="300"
                            VerticalAlignment="Top"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="{ThemeResource OverlayCornerRadius}"
                            Translation="0,0,32">
                            <Border.Shadow>
                                <ThemeShadow x:Name="shadow" />
                            </Border.Shadow>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    HorizontalTextAlignment="Center"
                                    Text="表达式" />

                                <ScrollView Grid.Row="1" Width="150">
                                    <StackPanel Orientation="Vertical" Spacing="5">
                                        <ListView
                                            x:Name="ExpressPictStateListView"
                                            AllowDrop="False"
                                            CanDragItems="False"
                                            CanReorderItems="False"
                                            ItemTemplate="{StaticResource ExpressPictStateTemplate}"
                                            ItemsSource="{x:Bind ViewModel.ExpressPictStates, Mode=OneWay}"
                                            Loaded="ExpressPictStateListView_Loaded"
                                            SelectionMode="None" />
                                    </StackPanel>
                                </ScrollView>

                                <Button
                                    x:Name="AddExpress"
                                    Grid.Row="2"
                                    HorizontalAlignment="Stretch"
                                    Content="+">
                                    <Button.Flyout>
                                        <Flyout>
                                            <Grid>
                                                <StackPanel x:Name="ExpressAddPanel" Orientation="Horizontal">
                                                    <ComboBox x:Name="ExpressOp" SelectedIndex="0">
                                                        <x:String>==</x:String>
                                                        <x:String>&gt;</x:String>
                                                    </ComboBox>
                                                    <NumberBox
                                                        x:Name="MyNumberBox"
                                                        PlaceholderText="输入数字"
                                                        Value="1" />
                                                    <controls:ColorPickerButton
                                                        x:Name="ExpressColorPicker"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Top"
                                                        SelectedColor="#38B9E3" />
                                                    <Button Click="ExpressAdd_Click" Content="添加" />
                                                </StackPanel>
                                                <TeachingTip
                                                    x:Name="TestButton1TeachingTip"
                                                    Title="错误"
                                                    MinWidth="100"
                                                    MaxWidth="100"
                                                    IsLightDismissEnabled="True"
                                                    PreferredPlacement="Top"
                                                    Subtitle="存在相同的表达式"
                                                    Target="{x:Bind ExpressAddPanel}"
                                                    Visibility="Collapsed">
                                                    <TeachingTip.IconSource>
                                                        <SymbolIconSource Symbol="ContactInfo" />
                                                    </TeachingTip.IconSource>
                                                </TeachingTip>
                                            </Grid>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </Border>

                    </Grid>

                </Grid>
            </controls:Case>
        </controls:SwitchPresenter>
    </Grid>
</Page>
